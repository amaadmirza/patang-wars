{
  "appId": "pk.patangwars.game",
  "appName": "Patang Wars",
  "webDir": "www",
  "backgroundColor": "#1e2350",
  "android": { "backgroundColor": "#1e2350", "allowMixedContent": false, "webContentsDebuggingEnabled": false },
  "ios": { "backgroundColor": "#1e2350", "contentInset": "never", "scrollEnabled": false },
