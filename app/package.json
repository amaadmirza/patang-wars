{
  "name": "patang-wars-app",
  "private": true,
  "version": "1.7.3",
  "description": "Bo Kata! for Android and iPhone (Capacitor). The whole game runs inside the app, offline.",
  "scripts": {
    "www": "node ../build.js --app",
    "assets": "capacitor-assets generate --iconBackgroundColor '#1e2350' --iconBackgroundColorDark '#1e2350' --splashBackgroundColor '#1e2350' --splashBackgroundColorDark '#1e2350'",
    "add": "cap add android && cap add ios",
    "patch": "node scripts/patch-native.js",
    "sync": "npm run www && cap sync"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
